  "reused": [
    {
      "name": "DRMP",
      "reference": "IETF RFC 7944 [21]",
      "usage": "Allows Diameter endpoints to indicate the relative priority of Diameter transactions."
    },
    {
      "name": "Subscription-Id",
      "reference": "IETF RFC 4006 [5]",
      "usage": "The identification of the subscription (IMSI, MSISDN, etc)"
    },
    {
      "name": "Load",
      "reference": "IETF RFC 8583 [22]",
      "usage": "The AVP used to convey load information between Diameter nodes.This AVP and all AVPs within this grouped AVP shall have the 'M' bit cleared."
    },
    {
      "name": "Logical-Access-ID",
      "reference": "ETSI TS 283 034 [17]",
      "usage": "Contains a CircuitID (as defined in IETF RFC 3046 [18]). The Logical Access ID may explicitly contain the identity of the Virtual Path and Virtual Channel carrying the traffic. Applicable only for Fixed Broadband Access network convergence as defined in annex A.This AVP shall have the 'M' bit cleared."
    },
    {
      "name": "OC-OLR",
      "reference": "IETF 7683 [20]",
      "usage": "Contains the necessary information to convey an overload report."
    },
    {
      "name": "OC-Supported-Features",
      "reference": "IETF 7683 [20]",
      "usage": "Defines the support for the Diameter overload indication conveyence by the sending node."
    },
    {
      "name": "Physical-Access-ID",
      "reference": "ETSI TS 283 034 [17]",
      "usage": "Identifies the physical access to which the user equipment is connected. Includes a port identifier and the identity of the access node where the port resides. Applicable only for Fixed Broadband Access network convergence as defined in annex A.This AVP shall have the 'M' bit cleared."
    },
    {
      "name": "Supported-Features",
      "reference": "3GPP TS 29.229 [15]",
      "usage": "If present in a request, this AVP informs the destination host about the features that the origin host supports. If present in an answer, this AVP informs the destination host about common features with the origin host."
    }
  ]
}
